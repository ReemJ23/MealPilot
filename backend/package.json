{
  "name": "@mealpilot/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node dist/server.js",
    "db:init": "node --import tsx scripts/initDatabase.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.database.test.ts\"",
    "test:database": "vitest run tests/Auth.database.test.ts",
    "build": "tsc"
  },
  "dependencies": {
    "cookie": "2.0.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15"
  }
}
