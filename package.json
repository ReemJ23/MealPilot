{
  "name": "mealpilot",
  "version": "0.1.0",
  "private": true,
  "description": "A student meal planning and kitchen organization project",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "db:init": "npm run db:init --workspace backend",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:database": "npm run test:database --workspace backend",
    "build": "npm run build --workspaces",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
